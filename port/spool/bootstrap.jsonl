{"attempts": 1, "body": {"description": "One invocation of the factory. Committed before any agent starts.", "icon": "Deployment", "identifier": "daisy_run", "relations": {"approval": {"many": false, "required": false, "target": "daisy_approval", "title": "Approval"}, "brief": {"many": false, "required": true, "target": "daisy_brief", "title": "Brief"}, "lanes": {"many": true, "required": false, "target": "daisy_lane", "title": "Lanes"}, "services": {"many": true, "required": false, "target": "daisy_service", "title": "Services"}}, "schema": {"properties": {"approved": {"title": "Approved", "type": "boolean"}, "approved_by": {"title": "Approved by", "type": "string"}, "audit_head": {"title": "Audit chain head", "type": "string"}, "fos_target": {"title": "Factor of safety target", "type": "number"}, "gates_failed": {"title": "Gates failed", "type": "number"}, "gates_run": {"title": "Gates run", "type": "number"}, "min_contrast_ratio": {"title": "Lowest contrast ratio", "type": "number"}, "min_physics_fos": {"title": "Lowest physics FoS", "type": "number"}, "mode": {"description": "Whether Port was actually reached, or the run was spooled. Recorded so no report can imply the wrong one.", "enum": ["live", "dry"], "title": "Governance mode", "type": "string"}, "plan": {"format": "markdown", "title": "Plan", "type": "string"}, "plan_sha": {"description": "blake2b over the committed plan. The approval is bound to this value, so a plan edited after approval cannot be released.", "title": "Plan hash", "type": "string"}, "released_at": {"format": "date-time", "title": "Released", "type": "string"}, "retry_cap": {"title": "Retry cap", "type": "number"}, "scrape_age_s": {"title": "Scrape age (s)", "type": "number"}, "started_at": {"format": "date-time", "title": "Started", "type": "string"}, "status": {"enum": ["planned", "building", "gated", "awaiting_approval", "released", "blocked", "denied"], "title": "Status", "type": "string"}, "taste_findings": {"title": "Taste findings", "type": "number"}}, "required": ["status"]}, "title": "Run"}, "hash": "9ea58a3f2a9015c631d0910a0e4f14f5", "method": "POST", "mode": "live", "path": "/blueprints", "prev": "8b60ba656bcc467c75be555e5ce1a9fd", "resource": "blueprint:daisy_run", "seq": 9, "status": 201, "ts": 1787440520.335}
{"attempts": 1, "body": {"identifier": "release_readiness", "levels": [{"color": "paleBlue", "title": "Basic"}, {"color": "bronze", "title": "Bronze"}, {"color": "silver", "title": "Silver"}, {"color": "gold", "title": "Gold"}], "rules": [{"description": "No plan hash means no agent should ever have started.", "identifier": "plan_committed", "level": "Bronze", "query": {"combinator": "and", "conditions": [{"operator": "isNotEmpty", "property": "plan_sha"}]}, "title": "The plan was committed before anything ran"}, {"identifier": "gates_ran", "level": "Bronze", "query": {"combinator": "and", "conditions": [{"operator": ">=", "property": "gates_run", "value": 1}]}, "title": "The deterministic gates ran"}, {"identifier": "no_failed_gates", "level": "Bronze", "query": {"combinator": "and", "conditions": [{"operator": "=", "property": "gates_failed", "value": 0}]}, "title": "Every gate that ran, passed"}, {"description": "Closed-form bending, shear, mass and thermal. No model in the path.", "identifier": "physics_fos", "level": "Silver", "query": {"combinator": "and", "conditions": [{"operator": ">=", "property": "min_physics_fos", "value": 1.5}]}, "title": "Physics margin at or above FoS 1.5"}, {"description": "WCAG AA for normal text, computed in both themes.", "identifier": "wcag_contrast", "level": "Silver", "query": {"combinator": "and", "conditions": [{"operator": ">=", "property": "min_contrast_ratio", "value": 4.5}]}, "title": "Every text pair at or above 4.5:1"}, {"description": "Twenty named tells with file:line, not a score out of ten.", "identifier": "taste_clean", "level": "Silver", "query": {"combinator": "and", "conditions": [{"operator": "=", "property": "taste_findings", "value": 0}]}, "title": "Zero taste findings"}, {"description": "Past the TTL the part cannot be certified: there is no fallback table in the code path.", "identifier": "scrape_fresh", "level": "Silver", "query": {"combinator": "and", "conditions": [{"operator": "<=", "property": "scrape_age_s", "value": 900}]}, "title": "Scraped ground truth inside its 900 s TTL"}, {"description": "Named, and bound to the plan hash. An unattributed approval is an audit trail with a hole in it.", "identifier": "human_approved", "level": "Gold", "query": {"combinator": "and", "conditions": [{"operator": "=", "property": "approved", "value": true}, {"operator": "isNotEmpty", "property": "approved_by"}]}, "title": "A human approved this exact plan"}], "title": "Release readiness"}, "hash": "307599d18440c33eedd587cd81630cb1", "method": "POST", "mode": "live", "path": "/blueprints/daisy_run/scorecards", "prev": "9ea58a3f2a9015c631d0910a0e4f14f5", "resource": "scorecard:daisy_run:release_readiness", "seq": 10, "status": 201, "ts": 1787440524.528}
