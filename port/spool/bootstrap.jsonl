{"attempts": 1, "body": {"identifier": "git", "properties": {"credentials": "none", "criticality": "critical", "docs_url": "https://git-scm.com/docs/git-worktree", "failure_mode": "Lanes cannot be isolated, so nothing starts.", "fallback": "None. Two agents in one tree is not a degraded mode, it is a different and much worse product.", "kind": "scm", "purpose": "One isolated worktree per lane. The orchestrator owns every commit; no agent touches git."}, "title": "Git worktrees"}, "hash": "cb439fe7e5c9cd4122f571b6c990b984", "method": "POST", "mode": "live", "path": "/blueprints/daisy_service/entities", "prev": "0ef09f6ea4ed256696dd66424f70ab0a", "resource": "entity:daisy_service:git", "seq": 17, "status": 201, "ts": 1787440532.787}
